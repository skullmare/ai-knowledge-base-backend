# ─── Приложение ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Разрешённые origin фронтенда через запятую.
# Если не задать — в разработке localhost:5173/5174, иначе домен продакшн-фронтенда.
CORS_ORIGINS=http://localhost:5173
# Домен refresh-куки (в проде)
MAIN_DOMAIN=

# ─── Базы данных ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/knowledge-base
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=knowledge_base
EMBEDDING_VECTOR_SIZE=1536

# ─── Безопасность ─────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# ─── Системный администратор (создаётся при первом запуске) ───
LOGIN_SUPER_ADMIN=admin
PASSWORD_SUPER_ADMIN=change-me
EMAIL_SUPER_ADMIN=admin@example.com

# ─── LLM и эмбеддинги ─────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ─── Хранилище файлов (Yandex Object Storage) ─────────────────
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
BUCKET_NAME=

# ─── Почта ────────────────────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@example.com
RESET_PASSWORD_URL=http://localhost:5173/reset-password

# ─── Мессенджеры (необязательны) ──────────────────────────────
TG_BOT_TOKEN=
MAX_BOT_TOKEN=
